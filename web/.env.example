## Claude / Anthropic (obligatorio)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5-20250929

## OpenAI Images (opcional — imagen de portada del post)
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1

## ElevenLabs (opcional — audio con tu voz clonada)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

## Apify (opcional — scraping automático de prospectos en LinkedIn)
APIFY_API_TOKEN=
APIFY_ACTOR_ID=

## Resend (opcional — correo-resumen diario)
RESEND_API_KEY=
NOTIFICATION_EMAIL=

## Autopiloto (obligatorio) — cadena secreta que protege /api/cron/daily
## Vercel la inyecta automáticamente en la petición del cron si defines esta env var.
CRON_SECRET=

## Acceso al dashboard (obligatorio) — Basic Auth para todo el frontend
DASHBOARD_USER=
DASHBOARD_PASSWORD=

## Provisionadas automáticamente por las integraciones de Vercel (no las rellenes a mano):
## POSTGRES_URL, POSTGRES_URL_NON_POOLING, BLOB_READ_WRITE_TOKEN, etc.
