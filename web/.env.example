## Claude / Anthropic (obligatorio)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-3-5-sonnet-20241022

## OpenAI Images (opcional — imagen de portada del post)
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1

## ElevenLabs (opcional — audio con tu voz clonada)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

## Apify (opcional — scraping automático de prospectos en LinkedIn)
APIFY_API_TOKEN=
APIFY_ACTOR_ID=

## Resend (opcional — correo-resumen diario)
RESEND_API_KEY=
NOTIFICATION_EMAIL=

## Autopiloto (obligatorio) — cadena secreta que protege /api/cron/daily
## Vercel la inyecta automáticamente en la petición del cron si defines esta env var.
CRON_SECRET=

## Acceso al dashboard (obligatorio) — Basic Auth para todo el frontend
DASHBOARD_USER=
DASHBOARD_PASSWORD=

## Base de datos Neon/Postgres — se rellena sola al conectar la integración de Vercel.
## Si ejecutas en local con `vercel env pull`, el .env.local generado tendrá estas variables
## con el prefijo del proyecto (ej. linkedintothemoon_POSTGRES_URL). El código en db.ts
## las resuelve automáticamente, así que NO necesitas editar nada a mano.
## POSTGRES_URL=
## POSTGRES_URL_NON_POOLING=
## POSTGRES_USER=
## POSTGRES_HOST=
## POSTGRES_PASSWORD=
## POSTGRES_DATABASE=

